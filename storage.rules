rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.esAdmin == true;
    }

    // Archivos de la landing (videos, prints): lectura pública, escritura solo admin
    match /landing/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 60 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') ||
            request.resource.contentType.matches('video/.*'));
    }

    // Comprobantes de transferencia: lectura pública, escritura solo admin
    match /comprobantes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos y videos de proveedores: lectura pública, escritura solo admin
    match /proveedores/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 60 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') ||
            request.resource.contentType.matches('video/.*'));
    }
  }
}
